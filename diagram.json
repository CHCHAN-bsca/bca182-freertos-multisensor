{
  "version": 1,
  "author": "Chan",
  "editor": "wokwi",
  "parts": [
    { "type": "board-stm32-bluepill", "id": "stm32", "top": 80, "left": 180, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -120, "left": 400, "attrs": { "temperature": "25.4", "humidity": "61.2" } },
    { "type": "wokwi-resistor", "id": "dhtPullup", "top": -50, "left": 350, "rotate": 90, "attrs": { "value": "10000" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 300, "left": 400, "attrs": { "lux": "500" } },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": 320, "left": -50, "attrs": { "delayTime": "3", "inhibitTime": "1" } },
    { "type": "wokwi-ky-040", "id": "encoder", "top": 120, "left": -120, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -120, "left": -80, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 10, "left": 450, "attrs": { "volume": "0.2", "mode": "smooth" } }
  ],
  "connections": [
    [ "stm32:A9", "$serialMonitor:RX", "green", [] ],
    [ "stm32:A10", "$serialMonitor:TX", "green", [] ],
    [ "dht:VCC", "stm32:3V3.1", "red", [] ],
    [ "dht:GND", "stm32:GND.1", "black", [] ],
    [ "dht:SDA", "stm32:B0", "cyan", [] ],
    [ "dhtPullup:1", "dht:SDA", "cyan", [] ],
    [ "dhtPullup:2", "stm32:3V3.1", "red", [] ],
    [ "ldr:VCC", "stm32:3V3.1", "red", [] ],
    [ "ldr:GND", "stm32:GND.1", "black", [] ],
    [ "ldr:AO", "stm32:A0", "magenta", [] ],
    [ "pir:VCC", "stm32:5V.1", "red", [] ],
    [ "pir:GND", "stm32:GND.2", "black", [] ],
    [ "pir:OUT", "stm32:B1", "orange", [] ],
    [ "encoder:VCC", "stm32:3V3.2", "red", [] ],
    [ "encoder:GND", "stm32:GND.3", "black", [] ],
    [ "encoder:CLK", "stm32:B12", "green", [] ],
    [ "encoder:DT", "stm32:B13", "yellow", [] ],
    [ "oled:VCC", "stm32:3V3.2", "red", [] ],
    [ "oled:GND", "stm32:GND.3", "black", [] ],
    [ "oled:SCL", "stm32:B6", "blue", [] ],
    [ "oled:SDA", "stm32:B7", "white", [] ],
    [ "buzzer:1", "stm32:GND.3", "black", [] ],
    [ "buzzer:2", "stm32:B10", "purple", [] ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf",
    "convertEol": true
  }
}